# 이 파일을 복사해서 .env 를 만들고 값을 채운다. (.env 는 git에 올라가지 않는다)
DB_NAME=kany
DB_USERNAME=kany
DB_PASSWORD=
DB_ROOT_PASSWORD=

# 로그인 토큰 서명 키. 32자 이상의 무작위 문자열. 만드는 법: openssl rand -hex 32
JWT_SECRET=

# 서버가 처음 뜰 때 이 계정을 관리자로 만든다. 이미 있으면 바꾸지 않는다.
ADMIN_EMAIL=admin@kany.local
ADMIN_PASSWORD=

# Docker로 전체를 띄웠을 때 브라우저로 접속할 포트 (기본 8081). 8080은 개발용 백엔드(bootRun)가 쓰도록 비워둔다.
HTTP_PORT=8081
